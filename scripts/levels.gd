static var _last_id := 0


## Уникальный номер для нового узла программы.
static func new_id() -> int:
	_last_id += 1
	return _last_id


## Превращает сокращённую запись решения в дерево программы.
static func to_program(items: Array) -> Array:
	var block := []
	for item in items:
		var node := {"id": new_id()}
		if item is String:
			node["cmd"] = item
		else:
			node["cmd"] = item[0]
			if item[0] == "repeat":
				node["count"] = item[1]
			else:
				node["cond"] = item[1]
			node["body"] = to_program(item[2])
		block.append(node)
	return block
