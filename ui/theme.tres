HeaderLabel/fonts/font = SubResource("InterBold")
Label/colors/font_color = Color(0.671, 0.82, 0.776, 1)
LineEdit/colors/font_color = Color(1, 1, 0.996, 1)
LineEdit/styles/focus = SubResource("Empty")
LineEdit/styles/normal = SubResource("Field")
OptionButton/colors/font_color = Color(0, 0.118, 0.114, 1)
OptionButton/colors/font_hover_color = Color(0, 0.118, 0.114, 1)
OptionButton/colors/font_pressed_color = Color(0, 0.118, 0.114, 1)
OptionButton/colors/font_focus_color = Color(0, 0.118, 0.114, 1)
OptionButton/styles/hover = SubResource("BtnHover")
OptionButton/styles/normal = SubResource("BtnNormal")
OptionButton/styles/pressed = SubResource("BtnPressed")
PanelContainer/styles/panel = SubResource("Panel")
PopupMenu/colors/font_color = Color(1, 1, 0.996, 1)
PopupMenu/colors/font_hover_color = Color(0, 0.118, 0.114, 1)
PopupMenu/styles/hover = SubResource("PopupHover")
PopupMenu/styles/panel = SubResource("Popup")
SelectedButton/base_type = &"Button"
SelectedButton/styles/hover = SubResource("SelectedHover")
SelectedButton/styles/normal = SubResource("SelectedNormal")
SelectedButton/styles/pressed = SubResource("SelectedNormal")
SpinBox/colors/down_icon_modulate = Color(1, 1, 0.996, 1)
SpinBox/colors/up_icon_modulate = Color(1, 1, 0.996, 1)
StepButton/base_type = &"Button"
StepButton/styles/hover = SubResource("AccentNormal")
StepButton/styles/normal = SubResource("AccentNormal")
StepButton/styles/pressed = SubResource("AccentNormal")
TooltipLabel/colors/font_color = Color(1, 1, 0.996, 1)
TooltipPanel/styles/panel = SubResource("Popup")
VScrollBar/styles/grabber = SubResource("ScrollGrab")
VScrollBar/styles/grabber_highlight = SubResource("ScrollGrab")
