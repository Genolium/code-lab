[gd_resource type="Theme" format=3]

; Палитра (Happy Hues, тёмно-зелёная):
;   фон #004643, заголовки #fffffe, текст #abd1c6, акцент/кнопки #f9bc60,
;   обводка и текст на кнопках #001e1d, светлое #e8e4e6, коралловый #e16162.

[ext_resource type="FontFile" path="res://fonts/InterVariable.ttf" id="1_inter"]

[sub_resource type="FontVariation" id="InterMedium"]
base_font = ExtResource("1_inter")
variation_opentype = {
2003265652: 560
}

[sub_resource type="FontVariation" id="InterBold"]
base_font = ExtResource("1_inter")
variation_opentype = {
2003265652: 720
}

