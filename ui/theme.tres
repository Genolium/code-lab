[resource]
default_font = ExtResource("1_inter")
default_font_size = 16
AccentButton/base_type = &"Button"
AccentButton/styles/hover = SubResource("AccentHover")
AccentButton/styles/normal = SubResource("AccentNormal")
AccentButton/styles/pressed = SubResource("AccentPressed")
Button/colors/font_color = Color(0, 0.118, 0.114, 1)
Button/colors/font_disabled_color = Color(0.671, 0.82, 0.776, 0.5)
Button/colors/font_focus_color = Color(0, 0.118, 0.114, 1)
Button/colors/font_hover_color = Color(0, 0.118, 0.114, 1)
Button/colors/font_hover_pressed_color = Color(0, 0.118, 0.114, 1)
Button/colors/font_pressed_color = Color(0, 0.118, 0.114, 1)
Button/fonts/font = SubResource("InterMedium")
Button/styles/disabled = SubResource("BtnDisabled")
Button/styles/focus = SubResource("Empty")
Button/styles/hover = SubResource("BtnHover")
Button/styles/normal = SubResource("BtnNormal")
Button/styles/pressed = SubResource("BtnPressed")
HSeparator/constants/separation = 14
HSeparator/styles/separator = SubResource("SeparatorLine")
HSlider/styles/grabber_area = SubResource("SliderFill")
HSlider/styles/grabber_area_highlight = SubResource("SliderFill")
HSlider/styles/slider = SubResource("SliderTrack")
